# --- LLM (SiliconFlow) ---
SILICON_FLOW_API_KEY="<your-key>"
SILICON_FLOW_BASE_URL="https://api.siliconflow.cn/v1"

SILICON_FLOW_NL2SQL_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"
SILICON_FLOW_REASONING_MODEL="deepseek-ai/DeepSeek-V3"
SILICON_FLOW_HELPER_MODEL="Qwen/Qwen2.5-32B-Instruct"

# embedding model
SILICON_FLOW_EMBEDDING_MODEL="BAAI/bge-large-zh-v1.5"
SILICON_FLOW_EMBEDDING_MODEL_DIMENSION=1536

# rerank model
SILICON_FLOW_RERANK_MODEL="BAAI/bge-reranker-v2-m3"
SILICON_FLOW_RERANK_MODEL_TOP_N=5
SILICON_FLOW_RERANK_MODEL_MAX_CHUNKS_PER_DOC=1024
SILICON_FLOW_RERANK_MODEL_OVERLAP_TOKENS=128

# --- Database ---
# Either set DATABASE_URL directly (spec §4.1):
# DATABASE_URL="postgresql://postgres:admin@localhost:5432/postgres"
# ...or keep the 5 separate vars (legacy, still supported via settings.sqlalchemy_url):
DATABASE_NAME="postgres"
DATABASE_USER="postgres"
DATABASE_PASSWORD="admin"
DATABASE_HOST="localhost"
DATABASE_PORT=5432

# Eval / read-only role (least-privilege; consumed by app.core.database when present)
# Bootstrap with: psql -f scripts/sql/bootstrap_ro_role.sql
# The app falls back to DATABASE_* with a warning if these are unset.
EVAL_DATABASE_USER="<your-read-only-role>"
EVAL_DATABASE_PASSWORD="<your-read-only-password>"

# --- Observability (optional, spec §3.2 决策 8) ---
# LANGFUSE_PUBLIC_KEY=""
# LANGFUSE_SECRET_KEY=""
# LANGFUSE_HOST="https://cloud.langfuse.com"
